# Prima i luoghi — variabili di ambiente del frontend.
#
# ATTENZIONE: tutte le variabili VITE_* vengono incorporate nel bundle JavaScript
# pubblico. NON sono segreti. Non inserire MAI qui (o nel repo/CI) la service_role
# key, la SUPABASE_SECRET_KEY, password PostgreSQL/SMTP o segreti CAPTCHA.
# La protezione reale dei dati e' garantita dalle policy RLS su Supabase.

# URL pubblico del progetto Supabase (regione UE).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Publishable (anon) key del progetto Supabase. Pubblica per definizione.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Base path per il deploy. Su GitHub Pages "project site" usare "/NOME-REPO/".
# In locale o con dominio personalizzato usare "/".
VITE_BASE=/

# Opzionale: token cartografico pubblico limitato al dominio (es. MapTiler).
# Se assente, la mappa usa lo style demo di MapLibre.
VITE_MAP_STYLE_URL=
